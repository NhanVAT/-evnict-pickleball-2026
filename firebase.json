{
  "hosting": {
    "public": "public",
    "ignore": ["**/.*"],
    "cleanUrls": true,
    "headers": [
      { "source": "**/*.@(js|css|json|html)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
    ]
  },
  "database": { "rules": "database.rules.json" }
}
